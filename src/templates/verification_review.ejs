<!DOCTYPE html>
<html lang="<%= locale %>" dir="<%= dir %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= t(`${key}.subject`) %></title>
  </head>
  <body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1a1a1a;">
    <p><%= t("common.greeting", { firstName }) %></p>
    <p><%= t(`${key}.body`) %></p>
    <ul>
      <% items.forEach(function (item) { %>
      <li>
        <strong><%= item.label %></strong> :
        <%= t(item.approved ? "verification_review.approved" : "verification_review.rejected") %><% if (!item.approved && item.reason) { %> · <%= item.reason %><% } %>
      </li>
      <% }) %>
    </ul>
    <p><a href="<%= link %>" style="color: #667eea"><%= t(`${key}.button`) %></a></p>
    <p><strong><%= t("common.signature") %></strong></p>
  </body>
</html>
